{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "apps/web/src/styles.css",
    "functions": ["cn", "cva"],
  },
  "ignorePatterns": [
    ".agents/**",
    "packages/design/prismark-dark.html",
    "packages/design/screens.json",
    "pnpm-lock.yaml",
  ],
}
