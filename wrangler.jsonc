{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prismark",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  // Nitro builds the worker entry to .output/server/index.mjs
  "main": ".output/server/index.mjs",
  // Static assets generated by Vite/Nitro
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "prismark.tech",
      "custom_domain": true
    }
  ],
  "upload_source_maps": true,
  "build": {
    "command": "pnpm install --frozen-lockfile && pnpm build"
  }
}
